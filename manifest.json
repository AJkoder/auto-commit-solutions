{
  "manifest_version": 3,
  "name": "LeetCode Git Sync Extension",
  "version": "1.0",
  "description": "Auto-syncs LeetCode submissions directly to GitHub!",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://leetcode.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}